# Configuración del servidor DAMM+. No publiques los secretos.
PORT=8080
NODE_ENV=production
CORS_ORIGIN=https://tarik-ab.github.io
# Usa una ruta persistente del hosting, por ejemplo /data/dammplus.sqlite
DB_FILE=./data/dammplus.sqlite
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ADMIN_USERNAME=Tarik
ADMIN_NAME=Tarik
# Define esta contraseña solo en las variables privadas del hosting (mínimo 12 caracteres).
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA_Y_UNICA
