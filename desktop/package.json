{
  "name": "damm-plus-desktop",
  "version": "1.0.0",
  "description": "DAMM+ desktop for Linux and Windows",
  "main": "main.cjs",
  "author": "DAMM+",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:windows": "electron-builder --win nsis zip"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.5",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.dammplus.desktop",
    "productName": "DAMM+",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "icon.png",
      "icon.ico"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "DAMM+-${version}-${arch}.${ext}",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "DAMM+-${version}-${arch}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DAMM+"
    }
  }
}
